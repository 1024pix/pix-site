                },
                "link_url": {
                  "config": {
                    "label": "link url",
                    "select": null
                  },
                  "type": "Link"
                }
              },
              "type": "Slice"
            }
          },
          "labels": {
            "navigation_group": [],
            "social_media": []
          }
