                    "thumbnails": []
                  },
                  "type": "Image"
                },
                "socialmedia_url": {
                  "config": {
                    "label": "socialmedia url",
                    "select": null
                  },
                  "type": "Link"
                }
              },
              "type": "Slice"
            },
            "logos_zone": {
              "description": "Navigation zone with logos",
              "display": "list",
              "fieldset": "logos_zone",
              "icon": "image",
              "non-repeat": {},
              "repeat": {
                "image": {
                  "config": {
                    "constraint": {},
                    "label": "image",
                    "thumbnails": []
                  },
                  "type": "Image"
                },
                "url": {
                  "config": {
                    "label": "url",
                    "select": null
                  },
                  "type": "Link"
                }
              },
              "type": "Slice"
            },
            "text": {
              "description": "Rich Text Section",
              "fieldset": "Text",
