{
  "format": "custom",
  "id": "news_item",
  "json": {
    "Main": {
      "title": {
        "config": {
          "label": "Title",
          "single": "heading1,heading2,heading3,heading4,heading5,heading6"
        },
        "type": "StructuredText"
      },
      "uid": {
        "config": {
          "label": "URI",
          "placeholder": "URI"
        },
        "type": "UID"
      },
      "category": {
        "config": {
          "default_value": "Announcement",
          "label": "Category",
          "options": [
            "Announcement",
            "Event",
            "Feature",
            "Society",
            "Engineering"
          ]
        },
        "type": "Select"
      },
      "date": {
        "config": {
          "label": "date"
        },
        "type": "Date"
      },
      "excerpt": {
        "config": {
          "label": "Excerpt",
          "multi": "paragraph,strong,em,hyperlink",
          "placeholder": "Privilégier 1 phrase ne dépassant pas la zone de saisie (soit une vingtaine de mots)."
        },
        "type": "StructuredText"
      },
      "body": {
        "config": {
          "label": "Body",
          "labels": [
            "number-large-blue",
            "number-large-blue center",
            "blue",
            "yellow",
            "large blue",
            "large",
            "center",
            "large center",
            "justify"
          ],
          "multi": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,o-list-item"
        },
        "type": "StructuredText"
      },
      "illustration": {
        "config": {
          "constraint": {},
          "label": "Illustration",
          "thumbnails": []
        },
        "type": "Image"
      },
      "slices": {
        "config": {
          "choices": {
            "web_snippet": {
              "description": "Any HTML/CSS/JS code snippet",
              "display": "list",
              "fieldset": "Web snippet",
              "icon": "code",
              "non-repeat": {
                "code": {
                  "config": {
                    "label": "code",
                    "multi": "paragraph"
                  },
                  "type": "StructuredText"
                }
              },
              "repeat": {},
              "type": "Slice"
            },
            "multiple_column": {
              "description": "Content in multiple column",
              "display": "grid",
              "fieldset": "Multiple column",
              "icon": "view_column",
              "non-repeat": {
                "vertical_align_center": {
                  "config": {
                    "default_value": "false",
                    "label": "vertical align center",
                    "options": [
                      "false",
                      "true"
                    ]
                  },
                  "type": "Select"
                }
              },
              "repeat": {
                "column_content": {
                  "config": {
                    "label": "Column content",
                    "labels": [
                      "number-large-blue",
                      "number-large-blue center",
                      "blue",
                      "yellow",
                      "large blue",
                      "large",
                      "center",
                      "large center",
                      "justify"
                    ],
                    "multi": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,o-list-item"
                  },
                  "type": "StructuredText"
                }
              },
              "type": "Slice"
            },
            "rich_text": {
              "description": "Rich text",
              "display": "list",
              "fieldset": "Rich text",
              "icon": "format_align_justify",
              "non-repeat": {
                "text": {
                  "config": {
                    "allowTargetBlank": true,
                    "label": "text",
                    "labels": [
                      "number-large-blue",
                      "number-large-blue center",
                      "blue",
                      "yellow",
                      "large blue",
                      "large",
                      "center",
                      "large center",
                      "justify"
                    ],
                    "multi": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,o-list-item"
                  },
                  "type": "StructuredText"
                }
              },
              "repeat": {},
              "type": "Slice"
            }
          },
          "labels": {}
        },
        "fieldset": "Slice zone",
        "type": "Slices"
      }
    },
    "Social Cards": {
      "title_meta_head": {
        "config": {
          "label": "title",
          "single": "heading1"
        },
        "type": "StructuredText"
      },
      "description_meta_head": {
        "config": {
          "label": "description",
          "single": "heading1,heading2,heading3,heading4,heading5,heading6"
        },
        "type": "StructuredText"
      },
      "image_meta_head": {
        "config": {
          "constraint": {},
          "label": "image",
          "thumbnails": []
        },
        "type": "Image"
      },
      "meta": {
        "config": {
          "choices": {
            "general_card": {
              "description": "General Social card for Facebook, LinkedIn, Google+, etc.",
              "fieldset": "General Card",
              "icon": "art_track",
              "non-repeat": {
                "title": {
                  "config": {
                    "label": "Title",
                    "placeholder": "Title...",
                    "single": "heading1"
                  },
                  "type": "StructuredText"
                },
                "description": {
                  "config": {
                    "label": "Description",
                    "placeholder": "Description...",
                    "single": "paragraph"
                  },
                  "type": "StructuredText"
                },
                "image": {
                  "config": {
                    "constraint": {
                      "height": 650,
                      "width": 1200
                    },
                    "label": "Image",
                    "thumbnails": []
                  },
                  "type": "Image"
                }
              },
              "repeat": {},
              "type": "Slice"
            },
            "twitter_card": {
              "description": "Twitter summary card with image",
              "fieldset": "Twitter Card",
              "icon": "subtitles",
              "non-repeat": {
                "title": {
                  "config": {
                    "label": "Title",
                    "placeholder": "Twitter Card Title...",
                    "single": "paragraph"
                  },
                  "type": "StructuredText"
                },
                "description": {
                  "config": {
                    "label": "Description",
                    "placeholder": "Twitter Card Description...",
                    "single": "paragraph"
                  },
                  "type": "StructuredText"
                },
                "image": {
                  "config": {
                    "constraint": {
                      "height": 300,
                      "width": 300
                    },
                    "label": "Image",
                    "thumbnails": [
                      {
                        "height": 314,
                        "name": "large_image",
                        "width": 600
                      }
                    ]
                  },
                  "type": "Image"
                }
              },
              "repeat": {},
              "type": "Slice"
            }
          }
        },
        "fieldset": "Slice zone",
        "type": "Slices"
      }
    }
  },
  "label": "News item",
  "repeatable": true,
  "status": true
}